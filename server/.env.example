# Copy this file to .env and fill in the values.

# Your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model. Check https://ai.google.dev/gemini-api/docs/models for current IDs.
GEMINI_MODEL=gemini-3.6-flash
# Used automatically when the main model is overloaded or rate-limited.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty to use a throwaway in-memory database for local development.
MONGODB_URI=

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
